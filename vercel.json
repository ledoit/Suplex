{
  "framework": null,
  "buildCommand": "echo static-export",
  "outputDirectory": "web",
  "installCommand": "echo no-install",
  "headers": [
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
